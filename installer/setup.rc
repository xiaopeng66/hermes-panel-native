// Hermes 模型面板 安装程序：图标 + 版本信息（纯 ASCII，避免 rc.exe 的编码猜测）。
#include <windows.h>

1 ICON "hermes.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "Hermes Model Panel Setup"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "HermesModelPanelSetup"
            VALUE "OriginalFilename", "HermesModelPanelNative-Setup.exe"
            VALUE "ProductName", "Hermes Model Panel"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
